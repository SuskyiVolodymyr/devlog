ANTHROPIC_API_KEY=

# Model config — override to use a different model tier
# Capable model for reasoning tasks (decompose, prioritize)
CLAUDE_MODEL_CAPABLE=claude-sonnet-4-5
# Fast model for simple generation tasks (status update)
CLAUDE_MODEL_FAST=claude-haiku-4-5
# Global fallback used if per-agent model is not set
CLAUDE_MODEL=claude-sonnet-4-5

DB_PATH=./devlog.db
